# c:\Users\User\workspace\simple_with\env.example
# 워크데스크 API 키 설정 파일
# 이 파일을 .env로 복사한 후 실제 API 키를 입력하세요

# 표준국어대사전 API (기존)
# 발급처: https://stdict.korean.go.kr/openapi/main/main.do
KOREAN_DICT_API_KEY=your_korean_dict_api_key

# 네이버 API (영어사전, 파파고 번역, 지역검색)
# 발급처: https://developers.naver.com
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# 기상청 공공데이터 API
# 발급처: https://data.go.kr (기상청_단기예보 조회서비스)
KMA_API_KEY=your_kma_api_key
